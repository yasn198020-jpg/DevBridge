{
  "projects": [
    {
      "name": "My project",
      "repository": "C:\\path\\to\\local\\repository",
      "branch": "feature/my-work",
      "buildCommand": "powershell.exe",
      "buildArguments": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts\\build.ps1"
      ],
      "workingDirectory": ".",
      "versionSource": {
        "url": "https://raw.githubusercontent.com/owner/updates-repo/android-channel/version.json",
        "field": "versionCode",
        "increment": 1,
        "minimum": 1,
        "placeholder": "{VERSION_CODE}"
      },
      "enabled": false
    }
  ]
}
